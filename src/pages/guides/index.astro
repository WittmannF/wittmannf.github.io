---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    href: '/guides/context-engineering',
    title: 'Context Engineering',
    description: 'RAG, memory, compression, agents, token budgets, security, and a production checklist — everything you need to build LLM systems that don\'t fall apart.',
    tags: ['AI', 'LLMs', 'RAG', 'Agents'],
  },
  {
    href: '/guides/claude-skills',
    title: 'Claude Code Skills',
    description: 'Build reusable slash commands, auto-triggered helpers, and multi-file automation systems for Claude Code — from your first one-liner to production-grade workflows.',
    tags: ['Claude Code', 'AI', 'Developer Tools', 'Automation'],
  },
];
---

<BaseLayout
  title="Interactive Guides — Fernando Wittmann"
  description="Hands-on interactive guides on AI, LLMs, and developer tools. Visual, explorable, and built to teach through doing."
  lang="en"
  alternateUrl="/pt/guides"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <h1 class="text-5xl font-bold mb-4">
        <span class="gradient-text">Interactive Guides</span>
      </h1>
      <p class="text-xl" style="color: var(--tn-text);">
        Hands-on, visual guides built to teach through doing — not just reading.
      </p>
    </div>

    <div style="border-top: 1px solid var(--tn-border);">
      {guides.map((guide) => (
        <article class="group py-8" style="border-bottom: 1px solid var(--tn-border);">
          <a href={guide.href} class="block">
            <div class="flex items-center gap-3 mb-3 text-xs" style="color: var(--tn-muted);">
              <span style="
                display: inline-flex; align-items: center; gap: 5px;
                background: rgba(99,102,241,0.12);
                border: 1px solid rgba(99,102,241,0.3);
                border-radius: 20px; padding: 2px 10px;
                font-size: 11px; font-weight: 700;
                color: #6366f1; letter-spacing: 0.5px; text-transform: uppercase;
              ">
                ✦ Interactive
              </span>
              <span>·</span>
              <div class="flex gap-2 flex-wrap">
                {guide.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <h2 class="text-xl font-bold mb-2 transition-colors group-hover:text-[var(--accent)]" style="color: var(--tn-text-bright);">
              {guide.title}
            </h2>
            <p style="color: var(--tn-text);">{guide.description}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
