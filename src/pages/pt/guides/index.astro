---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const guides = [
  {
    href: '/pt/guides/context-engineering',
    title: 'Engenharia de Contexto',
    description: 'RAG, memória, compressão, agentes, orçamento de tokens, segurança e um checklist de produção — tudo que você precisa para construir sistemas com LLMs que não desmoronam.',
    tags: ['IA', 'LLMs', 'RAG', 'Agentes'],
  },
  {
    href: '/pt/guides/claude-skills',
    title: 'Skills do Claude Code',
    description: 'Crie slash commands reutilizáveis, helpers auto-disparados e sistemas de automação multi-arquivo para o Claude Code — do seu primeiro one-liner a workflows prontos para produção.',
    tags: ['Claude Code', 'IA', 'Ferramentas de Dev', 'Automação'],
  },
];
---

<BaseLayout
  title="Guias Interativos — Fernando Wittmann"
  description="Guias interativos e práticos sobre IA, LLMs e ferramentas de desenvolvimento. Visuais, exploráveis e feitos para ensinar através da prática."
  lang="pt"
  alternateUrl="/guides"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <h1 class="text-5xl font-bold mb-4">
        <span class="gradient-text">Guias Interativos</span>
      </h1>
      <p class="text-xl" style="color: var(--tn-text);">
        Guias visuais e práticos feitos para ensinar através da prática — não apenas da leitura.
      </p>
    </div>

    <div style="border-top: 1px solid var(--tn-border);">
      {guides.map((guide) => (
        <article class="group py-8" style="border-bottom: 1px solid var(--tn-border);">
          <a href={guide.href} class="block">
            <div class="flex items-center gap-3 mb-3 text-xs" style="color: var(--tn-muted);">
              <span style="
                display: inline-flex; align-items: center; gap: 5px;
                background: rgba(99,102,241,0.12);
                border: 1px solid rgba(99,102,241,0.3);
                border-radius: 20px; padding: 2px 10px;
                font-size: 11px; font-weight: 700;
                color: #6366f1; letter-spacing: 0.5px; text-transform: uppercase;
              ">
                ✦ Interativo
              </span>
              <span>·</span>
              <div class="flex gap-2 flex-wrap">
                {guide.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <h2 class="text-xl font-bold mb-2 transition-colors group-hover:text-[var(--accent)]" style="color: var(--tn-text-bright);">
              {guide.title}
            </h2>
            <p style="color: var(--tn-text);">{guide.description}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
